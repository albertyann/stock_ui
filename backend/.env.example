# Copy this file to .env and fill in real values.
# Backend reads these server-side; the frontend never receives the API key.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgrespwd@localhost:5432/stock_data

# Redis (used for indicator-calc result caching)
REDIS_URL=redis://localhost:6379/0

# AI / LLM configuration (required for the stock chat assistant)
AI_API_KEY=your-api-key-here
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT=120

# Auth (TOTP + JWT, phone-based login)
# 生产环境必须改成强随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
# dev (HTTP) 用 False；prod (HTTPS) 必须 True
COOKIE_SECURE=False
COOKIE_DOMAIN=
# 邀请码有效期（小时）
INVITATION_EXPIRE_HOURS=168
